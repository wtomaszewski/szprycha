{
  "name": "szprycha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx tools/build-content.ts",
    "assets:generate": "tsx tools/gen-placeholders.ts",
    "map:generate": "tsx tools/gen-training-map.ts",
    "benchmark:driving": "tsx tools/benchmark-driving.ts",
    "map:generate:warsaw": "tsx tools/gen-warsaw-map.ts"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "phaser": "3.90.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/pngjs": "6.0.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "opentype.js": "2.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
